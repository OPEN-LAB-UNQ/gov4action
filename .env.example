DATABASE_URL=postgresql+psycopg2://gobernanza:CAMBIAR@localhost:5432/gobernanza
# Generar un valor propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
# El arranque rechaza valores vacíos, de ejemplo o con menos de 32 caracteres.
SECRET_KEY=
# Contraseña inicial propia: mínimo 12 caracteres; no reutilizar SECRET_KEY.
GOBERNANZA_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_VERIFICADOR_INCUBADORA=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
# Suspender proveedores sin eliminar credenciales (p. ej. claude,renderix).
MODELOS_SUSPENDIDOS=
APP_PORT=6163
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ID del único proyecto habilitado para nuevas operaciones de Monitoreo.
# Sin configuración, los registros existentes quedan en solo lectura.
# MONITOREO_PROYECTO_ID=

# Grupos de cursada (separados por coma) con Monitoreo en modo prueba y grupos que no usan votación (0.10.80).
# MONITOREO_GRUPOS_PRUEBA=Grupo A · comisión 2,Grupo B
# GRUPOS_SIN_VOTACION=Grupo A · comisión 2,Grupo B

# Instalación: primera cuenta de administración (se crea solo si la base no tiene usuarios).
# Sin ADMIN_PASSWORD se usa GOBERNANZA_PASSWORD.
ADMIN_EMAIL=admin@gobernanza.local
ADMIN_PASSWORD=
# Dirección pública con la que se arman enlaces y correos.
PUBLIC_BASE_URL=https://gobernanza.entornodepruebas.com.ar
